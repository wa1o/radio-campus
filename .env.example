# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# --- Obligatorias ---
# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/radio_campus
# true si el proveedor exige SSL (Render, Neon, Supabase…); false en local
PGSSL=false
# Secreto para firmar las sesiones del panel (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Clave de la pantalla pública: se abre como /screen?key=ESTA_CLAVE
SCREEN_KEY=cambia-esta-clave-de-pantalla

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_EMAIL=admin@ejemplo.edu.mx
ADMIN_PASSWORD=cambia-esta-contraseña

# --- Servicios externos ---
# YouTube Data API v3 (opcional): búsqueda, playlists completas y mejores etiquetas.
# Sin clave se pueden agregar canciones pegando enlaces.
YOUTUBE_API_KEY=
# Google Gemini (opcional, capa gratuita): el locutor redacta con IA y se sugieren
# etiquetas. Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de Gemini; el alias apunta siempre al Flash-Lite más reciente
GEMINI_MODEL=gemini-flash-lite-latest

# --- Contexto de la estación ---
STATION_TZ=America/Mexico_City
# Coordenadas para la temperatura (Open-Meteo, sin clave). Por defecto, Tampico.
STATION_LAT=22.2553
STATION_LON=-97.8686

# Puerto HTTP (los servicios de alojamiento suelen fijarlo solos)
PORT=3000
